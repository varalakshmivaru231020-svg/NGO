// Saksham Foundation — Prisma Schema (MySQL)
// Status/role/enum-like values are stored as String for flexibility.
//
// @db.Text / @db.LongText annotations below are required for MySQL — the
// default String maps to VARCHAR(191), which silently truncates free-text
// notes/addresses and (especially) the base64-encoded file-content fields.
// Never add these to an @id / @unique / @@index field — MySQL can't index
// a TEXT/LONGTEXT column without an explicit prefix length.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// USER / AUTH
// ─────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         String    @default("STAFF")
  modules      String? // CSV of frontend module keys this member can access
  avatar       String?   @db.LongText // profile photo, base64-encoded
  officeId     String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  office        Office?        @relation(fields: [officeId], references: [id])
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]
  notifications Notification[]
  auditLogs     AuditLog[]
  documents     UserDocument[]

  @@map("users")
}

// Staff/team-member documents (own profile). Mirrors StudentDocument.
model UserDocument {
  id        String   @id @default(cuid())
  userId    String
  category  String
  fileName  String
  mimeType  String?
  data      String   @db.LongText // base64-encoded file content
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_documents")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(512) // JWT — exceeds MySQL's default VARCHAR(191)
  userId    String
  userAgent String?  @db.VarChar(255) // browser/device of the login, for Login History
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(512) // FCM tokens can exceed MySQL's default VARCHAR(191)
  userId    String
  platform  String   @default("android")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

// ─────────────────────────────────────────
// DONORS
// ─────────────────────────────────────────

model Donor {
  id          String    @id @default(cuid())
  donorCode   String    @unique
  name        String
  mobile      String
  whatsapp    String?
  email       String?
  gender      String    @default("MALE")
  dob         DateTime?
  anniversary DateTime?
  address     String?   @db.Text
  city        String?
  state       String?
  country     String?
  pincode     String?
  occupation  String?
  company     String?
  tier        String    @default("SILVER")
  notes       String?   @db.Text
  avatar      String?   @db.LongText // profile photo, base64-encoded
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Donor Information card
  pan                    String?
  aadhaar                String?
  preferredContactMethod String? // CSV of: CALL, WHATSAPP, EMAIL (multi-select)

  categories     DonorCategoryMap[]
  donations      Donation[]
  sponsorships   Sponsorship[]
  reminders      Reminder[]
  activityVideos DonorActivityVideo[]
  activityImages DonorActivityImage[]

  @@index([name])
  @@index([mobile])
  @@map("donors")
}

// Donor Profile → Activities tab. Short activity videos, stored as base64 —
// pragmatic for now given volume; a real deployment should move this to
// object storage (S3/R2) and store just the URL.
model DonorActivityVideo {
  id           String   @id @default(cuid())
  donorId      String
  title        String // activity name
  activityDate DateTime @default(now())
  fileName     String
  mimeType     String? // video/mp4, video/quicktime, video/x-msvideo, video/webm
  data         String   @db.LongText // base64-encoded file content
  uploadedBy   String?
  createdAt    DateTime @default(now())

  donor Donor @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@index([donorId])
  @@map("donor_activity_videos")
}

// Donor Profile → Activities tab. Photos, alongside DonorActivityVideo —
// same pragmatic base64 storage approach.
model DonorActivityImage {
  id           String   @id @default(cuid())
  donorId      String
  title        String // activity name
  activityDate DateTime @default(now())
  fileName     String
  mimeType     String? // image/jpeg, image/png, image/webp
  data         String   @db.LongText // base64-encoded file content
  uploadedBy   String?
  createdAt    DateTime @default(now())

  donor Donor @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@index([donorId])
  @@map("donor_activity_images")
}

model DonorCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  icon        String   @default("users")
  color       String   @default("#0E8C76")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  donors DonorCategoryMap[]

  @@map("donor_categories")
}

model DonorCategoryMap {
  donorId    String
  categoryId String
  assignedAt DateTime @default(now())

  donor    Donor         @relation(fields: [donorId], references: [id], onDelete: Cascade)
  category DonorCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([donorId, categoryId])
  @@map("donor_category_map")
}

// ─────────────────────────────────────────
// DONATIONS
// ─────────────────────────────────────────

model DonationType {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  icon        String   @default("gift")
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  donations    Donation[]
  paymentLinks PaymentLink[]

  @@map("donation_types")
}

model Donation {
  id           String   @id @default(cuid())
  receiptNo    String   @unique
  donorId      String
  typeId       String
  amount       Int
  paymentMode  String   @default("CASH")
  status       String   @default("COMPLETED")
  reference    String?
  notes        String?  @db.Text
  chequeNo     String?
  bankName     String?
  date         DateTime @default(now())
  taxExemption Boolean  @default(false)
  receiptSent  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  donor       Donor        @relation(fields: [donorId], references: [id])
  type        DonationType @relation(fields: [typeId], references: [id])
  paymentLink PaymentLink?

  @@index([donorId])
  @@index([date])
  @@map("donations")
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  icon        String   @default("wallet")
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id          String   @id @default(cuid())
  voucherNo   String   @unique
  categoryId  String
  paidTo      String
  purpose     String   @db.Text
  amount      Int
  paymentMode String   @default("CASH")
  status      String   @default("COMPLETED")
  reference   String?
  chequeNo    String?
  bankName    String?
  preparedBy  String?
  approvedBy  String?
  receivedBy  String?
  notes       String?  @db.Text
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([date])
  @@map("expenses")
}

model PaymentLink {
  id         String    @id @default(cuid())
  slug       String    @unique
  donorId    String?
  amount     Int?
  purpose    String?   @db.Text
  donationId String?   @unique
  status     String    @default("ACTIVE")
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  // Set when Razorpay is configured and the link was created for real via
  // their Payment Links API — razorpayShortUrl is the actual rzp.io URL the
  // donor pays through. Null means Razorpay wasn't configured at creation
  // time, so this stayed an internal-only bookkeeping link.
  razorpayLinkId   String? @unique
  razorpayShortUrl String?

  // Which DonationType the eventual Donation should be recorded under —
  // set by callers (e.g. the public donate flow) that know the cause up
  // front, since `purpose` is only a free-text label and isn't reliably
  // reversible back to a DonationType id from the webhook.
  typeId String?
  type   DonationType? @relation(fields: [typeId], references: [id])

  donation Donation? @relation(fields: [donationId], references: [id])

  @@map("payment_links")
}

// ─────────────────────────────────────────
// STUDENTS / CHILDREN
// ─────────────────────────────────────────

model Center {
  id        String   @id @default(cuid())
  name      String   @unique
  city      String?
  address   String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  students Student[]
  staff    Staff[]

  @@map("centers")
}

// Admin-managed buckets for classifying children (e.g. Orphan, Single Parent,
// Day Scholar) — mirrors DonationType so the Settings screen can add/toggle.
model StudentCategory {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  students Student[]

  @@map("student_categories")
}

// Admin-managed option lists for students (Settings → Student Status /
// Education Level). `type` picks the list; Student.status / educationLevel
// store the stable `key`, so renaming a label never orphans existing rows.
model StudentLookup {
  id          String   @id @default(cuid())
  type        String   // STATUS | EDUCATION_LEVEL
  key         String
  label       String
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  // Built-in rows other code depends on (e.g. ACTIVE drives "active
  // students" counts) — renamable, but never deleted or deactivated.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([type, key])
  @@index([type])
  @@map("student_lookups")
}

model Student {
  id               String    @id @default(cuid())
  childId          String    @unique
  name             String
  gender           String    @default("MALE")
  dob              DateTime
  centerId         String
  categoryId       String?
  class            String?
  school           String?
  status           String    @default("ACTIVE")
  photo            String?   @db.LongText
  fatherName       String?
  motherName       String?
  guardianName     String?
  guardianRelation String?
  guardianPhone    String?
  address          String?   @db.Text
  medicalNotes     String?   @db.Text
  admissionDate    DateTime  @default(now())
  exitDate         DateTime?
  notes            String?   @db.Text

  // Education Details tab
  admissionNo      String?
  academicYear     String?
  joiningDate      DateTime?
  section          String?
  permanence       String?
  studentType      String?
  educationLevel   String?   // StudentLookup key (type EDUCATION_LEVEL)
  educationRemarks String?   @db.Text

  // Identity / government IDs
  aadhaarNumber         String?
  satNumber             String?
  penNumber             String?
  cwcNumber             String?
  abhaNumber            String?
  rationCardNumber      String?
  missionVatsalyaNumber String?
  caste                 String?
  subCaste              String?

  // Financial / welfare
  bankAccountDetails        String? @db.Text
  siblingNames              String? @db.Text
  incomeCertificateAmount   Int?
  incomeCertificateRdNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  center          Center            @relation(fields: [centerId], references: [id])
  category        StudentCategory?  @relation(fields: [categoryId], references: [id])
  sponsorships    Sponsorship[]
  achievements    Achievement[]
  attendance      Attendance[]
  growthRecords   GrowthRecord[]
  documents       StudentDocument[]
  progressRecords ProgressRecord[]

  @@index([name])
  @@index([centerId])
  @@index([categoryId])
  @@map("students")
}

// Date-wise height/weight history — lets staff compare a child's growth
// against previous records over time (see also the Progress tab chart).
model GrowthRecord {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime
  heightCm  Float?
  weightKg  Float?
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@map("growth_records")
}

// Uploaded documents (Aadhaar, birth certificate, report cards, etc.) —
// category is a free-text bucket label so the same model backs both the
// Documents tab and the Institution Details / Educational Documents section.
model StudentDocument {
  id        String   @id @default(cuid())
  studentId String
  category  String
  fileName  String
  mimeType  String?
  data      String   @db.LongText // base64-encoded file content
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

// Student Profile → Progress tab. One row per recorded performance
// check-in; the tab lists these newest-first as a history/timeline.
model ProgressRecord {
  id                  String   @id @default(cuid())
  studentId           String
  date                DateTime @default(now())
  academicScore       Int?
  attendancePercent   Float?
  behaviourRating     String?
  communicationSkills String?
  leadership          String?
  sportsPerformance   String?
  mentorRemarks       String?  @db.Text
  teacherRemarks      String?  @db.Text
  examResult          String?
  grade               String?
  createdAt           DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("progress_records")
}

model Sponsorship {
  id        String    @id @default(cuid())
  studentId String
  donorId   String
  startDate DateTime  @default(now())
  endDate   DateTime?
  amount    Int
  frequency String    @default("ANNUAL")
  notes     String?   @db.Text
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  donor   Donor   @relation(fields: [donorId], references: [id])

  @@map("sponsorships")
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime
  present   Boolean  @default(true)
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@map("attendance")
}

// ─────────────────────────────────────────
// ACHIEVEMENTS
// ─────────────────────────────────────────

model Achievement {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  description String?  @db.Text
  category    String   @default("ACADEMICS")
  date        DateTime @default(now())
  photos      Int      @default(0)
  videos      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("achievements")
}

// ─────────────────────────────────────────
// STAFF (employees — teachers, wardens, cooks…)
// ─────────────────────────────────────────

// HR records for the people the trust employs. Separate from User: most
// staff never log in, and a login account carries no salary/bank details.
// Salary figures are whole rupees per month, like every other amount here.
model Staff {
  id             String    @id @default(cuid())
  staffCode      String    @unique // STF0001 — from SequenceCounter 'staff-code'
  name           String
  gender         String    @default("MALE")
  dob            DateTime?
  mobile         String?
  whatsapp       String?
  email          String?
  address        String?   @db.Text
  photo          String?   @db.LongText
  aadhaarNumber  String?
  panNumber      String?
  designation    String
  centerId       String?
  joiningDate    DateTime?
  employmentType String    @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT | VOLUNTEER
  status         String    @default("ACTIVE")    // StaffLookup key of type STATUS
  workTimings    String?   // e.g. "9:00 AM - 6:00 PM" — printed on payslips

  // Salary structure
  basicSalary  Int     @default(0)
  hra          Int     @default(0)
  allowances   Int     @default(0)
  pfApplicable Boolean @default(false)

  // Bank
  bankName      String?
  accountNumber String?
  ifscCode      String?

  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  center   Center?       @relation(fields: [centerId], references: [id])
  children StaffChild[]
  salaries StaffSalary[]

  @@index([name])
  @@index([centerId])
  @@map("staff")
}

// Staff profile → Children / family details.
model StaffChild {
  id        String    @id @default(cuid())
  staffId   String
  name      String
  relation  String?
  dob       DateTime?
  school    String?
  createdAt DateTime  @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_children")
}

// Option lists for the staff form (Designation / Status), grown with the "+"
// next to each field. Staff.status stores the stable `key`; Staff.designation
// stores the label text, so the list only supplies choices.
model StaffLookup {
  id        String   @id @default(cuid())
  type      String   // DESIGNATION | STATUS
  key       String
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  // Built-in rows other code depends on (ACTIVE drives "active staff" counts).
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([type, key])
  @@index([type])
  @@map("staff_lookups")
}

// One row per staff member per month — what the payslip and the monthly /
// yearly salary report are built from. Whole rupees; gross / deductions / net
// are derived, never stored, so they can't drift from their parts.
model StaffSalary {
  id      String @id @default(cuid())
  staffId String
  month   String // YYYY-MM

  // Earnings
  basic      Int @default(0)
  hra        Int @default(0)
  allowances Int @default(0)
  overtime   Int @default(0)
  bonus      Int @default(0)

  // Deductions
  leaveDeduction Int @default(0)
  pf             Int @default(0)
  advance        Int @default(0)
  otherDeduction Int @default(0)

  // Attendance, as printed on the payslip
  workingDays      Int?
  leaveDays        Float   @default(0)
  workedOnHolidays Boolean @default(false)

  status      String    @default("PENDING") // PENDING | PAID
  paidOn      DateTime?
  paymentMode String?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, month])
  @@index([month])
  @@map("staff_salaries")
}

// ─────────────────────────────────────────
// REMINDERS
// ─────────────────────────────────────────

model Reminder {
  id        String   @id @default(cuid())
  donorId   String?
  type      String
  title     String
  message   String?  @db.Text
  dueDate   DateTime
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())

  donor Donor? @relation(fields: [donorId], references: [id], onDelete: SetNull)

  @@index([dueDate])
  @@map("reminders")
}

// ─────────────────────────────────────────
// OFFICES
// ─────────────────────────────────────────

model Office {
  id        String   @id @default(cuid())
  name      String
  city      String
  state     String?
  address   String?  @db.Text
  phone     String?
  email     String?
  isHQ      Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("offices")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String   @db.Text
  icon      String?
  route     String?
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ─────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────
// APPROVAL WORKFLOW
// Every Create/Edit/Delete initiated by a non-SUPER_ADMIN is captured here as
// a PENDING request. The original record is untouched until a SUPER_ADMIN
// approves, at which point the stored request is replayed and executed.
// ─────────────────────────────────────────

model ApprovalRequest {
  id            String    @id @default(cuid())
  module        String // first URL segment: donors, students, users, offices …
  action        String // CREATE | EDIT | DELETE
  method        String // POST | PATCH | PUT | DELETE
  path          String // originalUrl incl. /api/v1 prefix + query — used to replay
  targetId      String? // resource id for EDIT/DELETE
  subject       String? // human label (e.g. the child's/donor's name) for list cards
  payload       Json? // request body (the proposed new data)
  previousData  Json? // snapshot of the record before the change (for the diff view)
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reason        String?   @db.Text // rejection reason (mandatory on reject)
  requesterId   String
  requesterName String
  requesterRole String
  department    String? // requester's office name, for filtering
  reviewerId    String?
  reviewerName  String?
  reviewedAt    DateTime?
  resultId      String? // id of the created/updated record after approval
  error         String?   @db.Text // last replay error, if execution failed on approval
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([module])
  @@index([requesterId])
  @@map("approval_requests")
}

// ─────────────────────────────────────────
// APP SETTINGS — WhatsApp Business API (BotSyncWA)
// Single-row config edited from the admin panel; read by WhatsappService.
// ─────────────────────────────────────────

model WhatsappSetting {
  id            String   @id @default("singleton")
  storeNumber   String? // sender display number, e.g. 919832399399
  phoneNumberId String? // Meta Phone Number ID, sent with each message
  apiToken      String?  @db.Text // Bearer token
  apiUrl        String? // send endpoint (override); default botsyncwa messages URL
  // Native-Meta-passthrough mode (apiUrl containing "/api/meta"): the send URL
  // is built as `${apiUrl}/${apiVersion}/${phoneNumberId}/messages`. wabaId /
  // businessId are stored for reference only — not sent in the request.
  apiVersion    String? // Meta Graph API version, e.g. v19.0
  wabaId        String? // WhatsApp Business Account ID
  businessId    String? // Meta Business ID
  updatedAt     DateTime @updatedAt

  @@map("whatsapp_settings")
}

// Razorpay credentials for generating real, live payment links. Stored
// server-side (never sent to the browser except to the Super Admin settings
// screen) since the Key Secret must never be used client-side.
model RazorpaySetting {
  id            String   @id @default("singleton")
  keyId         String?
  keySecret     String?
  webhookSecret String? // Dashboard-configured Webhook Secret, distinct from the API key secret
  updatedAt     DateTime @updatedAt

  @@map("razorpay_settings")
}

// Atomic per-key sequence counter — powers donation receipt numbers and
// donor codes via a single INSERT ... ON DUPLICATE KEY UPDATE statement using
// MySQL's LAST_INSERT_ID(expr) trick (wrapped in a Prisma interactive
// transaction so both statements share one connection), which is race-free
// under concurrent requests by construction — MySQL has no RETURNING clause,
// so this replaces the previous Postgres ON CONFLICT ... RETURNING approach.
model SequenceCounter {
  key String @id
  seq Int    @default(0)

  @@map("sequence_counters")
}

// Single source of truth for organization identity (name/address/PAN/etc.),
// read by every receipt/voucher renderer instead of each keeping its own
// hardcoded copy.
model OrgSettings {
  id                 String   @id @default("singleton")
  name               String?
  address            String?  @db.Text
  city               String?
  state              String?
  country            String?
  pincode            String?
  phone              String?
  email              String?
  website            String?
  registrationNumber String?
  pan                String?
  reg12A             String?
  cert80G            String?
  fcra               String?
  logoBase64         String?  @db.LongText
  updatedAt          DateTime @updatedAt

  @@map("org_settings")
}
