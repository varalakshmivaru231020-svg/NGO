// Saksham Foundation — Prisma Schema (PostgreSQL)
// Status/role/enum-like values are stored as String for flexibility.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")  // pooled (runtime)
  directUrl = env("DIRECT_URL")    // direct (migrations)
}

// ─────────────────────────────────────────
// USER / AUTH
// ─────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         String    @default("STAFF")
  modules      String?   // CSV of frontend module keys this member can access
  avatar       String?
  officeId     String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  office        Office?        @relation(fields: [officeId], references: [id])
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  platform  String   @default("android")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

// ─────────────────────────────────────────
// DONORS
// ─────────────────────────────────────────

model Donor {
  id          String    @id @default(cuid())
  donorCode   String    @unique
  name        String
  mobile      String
  whatsapp    String?
  email       String?
  gender      String    @default("MALE")
  dob         DateTime?
  anniversary DateTime?
  address     String?
  city        String?
  state       String?
  country     String?
  pincode     String?
  occupation  String?
  company     String?
  tier        String    @default("SILVER")
  notes       String?
  avatar      String?   // profile photo, base64-encoded
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Donor Information card
  pan                    String?
  aadhaar                String?
  preferredContactMethod String? // CSV of: CALL, WHATSAPP, EMAIL (multi-select)

  categories    DonorCategoryMap[]
  donations     Donation[]
  sponsorships  Sponsorship[]
  reminders     Reminder[]
  activityVideos DonorActivityVideo[]

  @@index([name])
  @@index([mobile])
  @@map("donors")
}

// Donor Profile → Activities tab. Short activity videos, stored as base64 —
// pragmatic for now given volume; a real deployment should move this to
// object storage (S3/R2) and store just the URL.
model DonorActivityVideo {
  id           String   @id @default(cuid())
  donorId      String
  title        String   // activity name
  activityDate DateTime @default(now())
  fileName     String
  mimeType     String?  // video/mp4, video/quicktime, video/x-msvideo, video/webm
  data         String   // base64-encoded file content
  uploadedBy   String?
  createdAt    DateTime @default(now())

  donor Donor @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@index([donorId])
  @@map("donor_activity_videos")
}

model DonorCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String   @default("users")
  color       String   @default("#0E8C76")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  donors DonorCategoryMap[]

  @@map("donor_categories")
}

model DonorCategoryMap {
  donorId    String
  categoryId String
  assignedAt DateTime @default(now())

  donor    Donor         @relation(fields: [donorId], references: [id], onDelete: Cascade)
  category DonorCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([donorId, categoryId])
  @@map("donor_category_map")
}

// ─────────────────────────────────────────
// DONATIONS
// ─────────────────────────────────────────

model DonationType {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  icon        String   @default("gift")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  donations Donation[]

  @@map("donation_types")
}

model Donation {
  id           String   @id @default(cuid())
  receiptNo    String   @unique
  donorId      String
  typeId       String
  amount       Int
  paymentMode  String   @default("CASH")
  status       String   @default("COMPLETED")
  reference    String?
  notes        String?
  chequeNo     String?
  bankName     String?
  date         DateTime @default(now())
  taxExemption Boolean  @default(false)
  receiptSent  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  donor       Donor        @relation(fields: [donorId], references: [id])
  type        DonationType @relation(fields: [typeId], references: [id])
  paymentLink PaymentLink?

  @@index([donorId])
  @@index([date])
  @@map("donations")
}

model PaymentLink {
  id         String    @id @default(cuid())
  slug       String    @unique
  donorId    String?
  amount     Int?
  purpose    String?
  donationId String?   @unique
  status     String    @default("ACTIVE")
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  // Set when Razorpay is configured and the link was created for real via
  // their Payment Links API — razorpayShortUrl is the actual rzp.io URL the
  // donor pays through. Null means Razorpay wasn't configured at creation
  // time, so this stayed an internal-only bookkeeping link.
  razorpayLinkId   String?
  razorpayShortUrl String?

  donation Donation? @relation(fields: [donationId], references: [id])

  @@map("payment_links")
}

// ─────────────────────────────────────────
// STUDENTS / CHILDREN
// ─────────────────────────────────────────

model Center {
  id        String   @id @default(cuid())
  name      String   @unique
  city      String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  students Student[]

  @@map("centers")
}

model Student {
  id            String    @id @default(cuid())
  childId       String    @unique
  name          String
  gender        String    @default("MALE")
  dob           DateTime
  centerId      String
  class         String?
  school        String?
  status        String    @default("ACTIVE")
  photo         String?
  fatherName    String?
  motherName    String?
  guardianName     String?
  guardianRelation String?
  guardianPhone String?
  address       String?
  medicalNotes  String?
  admissionDate DateTime  @default(now())
  exitDate      DateTime?
  notes         String?

  // Education Details tab
  admissionNo    String?
  academicYear   String?
  joiningDate    DateTime?
  section        String?
  permanence     String?
  studentType    String?
  educationRemarks String?

  // Identity / government IDs
  aadhaarNumber    String?
  satNumber        String?
  penNumber        String?
  cwcNumber        String?
  abhaNumber       String?
  rationCardNumber String?
  missionVatsalyaNumber String?
  caste            String?
  subCaste         String?

  // Financial / welfare
  bankAccountDetails        String?
  siblingNames              String?
  incomeCertificateAmount   Int?
  incomeCertificateRdNumber String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  center        Center         @relation(fields: [centerId], references: [id])
  sponsorships  Sponsorship[]
  achievements  Achievement[]
  attendance    Attendance[]
  growthRecords GrowthRecord[]
  documents     StudentDocument[]
  progressRecords ProgressRecord[]

  @@index([name])
  @@index([centerId])
  @@map("students")
}

// Date-wise height/weight history — lets staff compare a child's growth
// against previous records over time (see also the Progress tab chart).
model GrowthRecord {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime
  heightCm  Float?
  weightKg  Float?
  notes     String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@map("growth_records")
}

// Uploaded documents (Aadhaar, birth certificate, report cards, etc.) —
// category is a free-text bucket label so the same model backs both the
// Documents tab and the Institution Details / Educational Documents section.
model StudentDocument {
  id        String   @id @default(cuid())
  studentId String
  category  String
  fileName  String
  mimeType  String?
  data      String   // base64-encoded file content
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

// Student Profile → Progress tab. One row per recorded performance
// check-in; the tab lists these newest-first as a history/timeline.
model ProgressRecord {
  id                  String   @id @default(cuid())
  studentId           String
  date                DateTime @default(now())
  academicScore       Int?
  attendancePercent   Float?
  behaviourRating     String?
  communicationSkills String?
  leadership          String?
  sportsPerformance   String?
  mentorRemarks       String?
  teacherRemarks      String?
  examResult          String?
  grade               String?
  createdAt           DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("progress_records")
}

model Sponsorship {
  id        String    @id @default(cuid())
  studentId String
  donorId   String
  startDate DateTime  @default(now())
  endDate   DateTime?
  amount    Int
  frequency String    @default("ANNUAL")
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  donor   Donor   @relation(fields: [donorId], references: [id])

  @@map("sponsorships")
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime
  present   Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@map("attendance")
}

// ─────────────────────────────────────────
// ACHIEVEMENTS
// ─────────────────────────────────────────

model Achievement {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  description String?
  category    String   @default("ACADEMICS")
  date        DateTime @default(now())
  photos      Int      @default(0)
  videos      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("achievements")
}

// ─────────────────────────────────────────
// REMINDERS
// ─────────────────────────────────────────

model Reminder {
  id        String   @id @default(cuid())
  donorId   String?
  type      String
  title     String
  message   String?
  dueDate   DateTime
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())

  donor Donor? @relation(fields: [donorId], references: [id], onDelete: SetNull)

  @@index([dueDate])
  @@map("reminders")
}

// ─────────────────────────────────────────
// OFFICES
// ─────────────────────────────────────────

model Office {
  id        String   @id @default(cuid())
  name      String
  city      String
  state     String?
  address   String?
  phone     String?
  email     String?
  isHQ      Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("offices")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  icon      String?
  route     String?
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ─────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  String?
  newValue  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────
// APPROVAL WORKFLOW
// Every Create/Edit/Delete initiated by a non-SUPER_ADMIN is captured here as
// a PENDING request. The original record is untouched until a SUPER_ADMIN
// approves, at which point the stored request is replayed and executed.
// ─────────────────────────────────────────

model ApprovalRequest {
  id            String    @id @default(cuid())
  module        String    // first URL segment: donors, students, users, offices …
  action        String    // CREATE | EDIT | DELETE
  method        String    // POST | PATCH | PUT | DELETE
  path          String    // originalUrl incl. /api/v1 prefix + query — used to replay
  targetId      String?   // resource id for EDIT/DELETE
  payload       Json?     // request body (the proposed new data)
  previousData  Json?     // snapshot of the record before the change (for the diff view)
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reason        String?   // rejection reason (mandatory on reject)
  requesterId   String
  requesterName String
  requesterRole String
  department    String?   // requester's office name, for filtering
  reviewerId    String?
  reviewerName  String?
  reviewedAt    DateTime?
  resultId      String?   // id of the created/updated record after approval
  error         String?   // last replay error, if execution failed on approval
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([module])
  @@index([requesterId])
  @@map("approval_requests")
}

// ─────────────────────────────────────────
// APP SETTINGS — WhatsApp Business API (BotSyncWA)
// Single-row config edited from the admin panel; read by WhatsappService.
// ─────────────────────────────────────────

model WhatsappSetting {
  id            String   @id @default("singleton")
  storeNumber   String?  // sender display number, e.g. 919832399399
  phoneNumberId String?  // Meta Phone Number ID, sent with each message
  apiToken      String?  // Bearer token
  apiUrl        String?  // send endpoint (override); default botsyncwa messages URL
  // Native-Meta-passthrough mode (apiUrl containing "/api/meta"): the send URL
  // is built as `${apiUrl}/${apiVersion}/${phoneNumberId}/messages`. wabaId /
  // businessId are stored for reference only — not sent in the request.
  apiVersion    String?  // Meta Graph API version, e.g. v19.0
  wabaId        String?  // WhatsApp Business Account ID
  businessId    String?  // Meta Business ID
  updatedAt     DateTime @updatedAt

  @@map("whatsapp_settings")
}

// Razorpay credentials for generating real, live payment links. Stored
// server-side (never sent to the browser except to the Super Admin settings
// screen) since the Key Secret must never be used client-side.
model RazorpaySetting {
  id        String   @id @default("singleton")
  keyId     String?
  keySecret String?
  updatedAt DateTime @updatedAt

  @@map("razorpay_settings")
}
