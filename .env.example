# App
NODE_ENV=development
PORT=3001
APP_NAME=Saksham Foundation API
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://saksham_user:saksham_secret@localhost:5432/saksham_db

# Redis
REDIS_URL=redis://:redis_secret@localhost:6379

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL (for Docker Compose)
POSTGRES_PASSWORD=saksham_secret
REDIS_PASSWORD=redis_secret

# Firebase Cloud Messaging
FCM_PROJECT_ID=your_firebase_project_id
FCM_CLIENT_EMAIL=your_service_account_email
FCM_PRIVATE_KEY="your_private_key_here"

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
